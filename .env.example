# Copy to apps/web/.env.local and apps/worker/.env.local (Next loads env from its own app dir).
# Never commit real values. Production secrets live in the deploy repo (spec section 7).
# No NEXT_PUBLIC_ keys: the browser never talks to the DB (R3).

# Authen (provisional, pending spec section 9 Q1: shared secret vs JWKS/server-side checks;
# the auth ticket may rename/replace these)
AUTHEN_SUPABASE_URL=
AUTHEN_JWT_SECRET=

# Allowlist: comma-separated Authen user IDs (spec section 4.2)
ALLOWLIST_USER_IDS=

# App database (stoktok Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-only (R3)
SUPABASE_SERVICE_ROLE_KEY=

# LLM (provider pending spec section 9 Q6)
LLM_PROVIDER=
LLM_API_KEY=
