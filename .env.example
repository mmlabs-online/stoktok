# Copy to apps/web/.env.local and apps/worker/.env.local (Next loads env from its own app dir).
# Never commit real values. Production secrets live in the deploy repo (spec section 7).
# No NEXT_PUBLIC_ keys: the browser never talks to the DB (R3).

# Authen = CaleChip Supabase project (identity only; server-only, R3). STK-004.
AUTHEN_SUPABASE_URL=          # https://<calechip-ref>.supabase.co (no path, no trailing slash)
AUTHEN_SUPABASE_ANON_KEY=     # CaleChip anon (legacy JWT) or sb_publishable_ key; read by web server code only
# Allowlist: comma-separated CaleChip auth.users.id UUIDs (JWT sub). Empty = nobody can log in.
ALLOWLIST_USER_IDS=

# App database (stoktok Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-only (R3)
SUPABASE_SERVICE_ROLE_KEY=

# LLM (provider pending spec section 9 Q6)
LLM_PROVIDER=
LLM_API_KEY=
