# Copy to apps/web/.env.local and apps/worker/.env.local (Next loads env from its own app dir).
# Never commit real values. Production secrets live in the deploy repo (spec section 7).
# No NEXT_PUBLIC_ keys: the browser never talks to the DB (R3).

# Authen = Supabase Auth of the stoktok Supabase project (identity only; server-only, R3). STK-004, STK-048.
AUTHEN_SUPABASE_URL=          # https://<stoktok-ref>.supabase.co, same value as SUPABASE_URL (no path, no trailing slash)
AUTHEN_SUPABASE_ANON_KEY=     # stoktok project anon (legacy JWT) or sb_publishable_ key; read by web server code only

# App database (self-hosted Postgres, ADR 0010; server-only, R3)
STOKTOK_DATABASE_URL=          # e.g. postgres://stoktok:<password>@localhost:5432/stoktok
STOKTOK_AI_KEYS_MASTER_KEY=          # 32 bytes base64 (head -c 32 /dev/urandom | base64); server-only (R3); optional: unset disables keys saved on Settings (ADR 0011)

# Legacy: read only by the running production release until the STK-084 cutover; code on main no longer reads them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (optional; blank disables that provider; server-only, R3). STK-072.
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
