{
  "name": "stoktok",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:check": "bash scripts/db-check.sh",
    "build": "pnpm -r --if-present build",
    "check:service-key": "bash scripts/check-no-service-key-in-client.sh",
    "check:deploy-env": "bash scripts/check-deploy-env.sh",
    "worker:eod": "pnpm --filter @stoktok/worker run job eod-prices",
    "worker:financials": "pnpm --filter @stoktok/worker run job financials",
    "worker:signals": "pnpm --filter @stoktok/worker run job signals"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
